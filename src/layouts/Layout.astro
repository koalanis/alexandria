---
interface Props {
	title?: string;
}

const { title = "Alexandria" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="An infinite 3D library, rendered with three.js" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
	}
	/* The renderer canvas fills the viewport, so any body margin shows up as
	   scrollbars and offsets the pointer/NDC mapping. */
	body {
		margin: 0;
		overflow: hidden;
	}
	canvas {
		display: block;
	}
</style>
